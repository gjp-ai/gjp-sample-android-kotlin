<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".GJPLabApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_designed"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_designed_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.GJPLab">
        <activity
            android:name=".features.deviceinfo.DeviceInfoActivity"
            android:exported="false"
            android:label="OS &amp; hardware"
            android:theme="@style/Theme.GJPLab" />
        <activity
            android:name=".features.httpurlconnection.HttpURLConnectionActivity"
            android:exported="false"
            android:label="HttpURLConnection"
            android:theme="@style/Theme.GJPLab" />
        <activity
            android:name=".features.httpurlconnection.HttpResponseActivity"
            android:exported="false"
            android:label="HTTP response"
            android:theme="@style/Theme.GJPLab" />
        <activity
            android:name=".features.firebase.FirebaseFeatureActivity"
            android:exported="false"
            android:label="Firebase"
            android:theme="@style/Theme.GJPLab" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.GJPLab" />
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GJPLab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
